<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RIZORA â€” Creator Growth Studio</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #07080d;
      --panel: #0e1018;
      --panel-2: #131620;
      --panel-3: #090b11;
      --border: #252936;
      --text: #f4f5f7;
      --muted: #8d93a3;
      --accent: #8b5cf6;
      --accent-2: #a78bfa;
      --green: #35d07f;
      --red: #ff667d;
      --yellow: #f5c451;
      --blue: #4da3ff;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: Inter, Arial, Helvetica, sans-serif;
      min-height: 100vh;
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    button:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .app {
      display: flex;
      min-height: 100vh;
    }

    /* SIDEBAR */
    .sidebar {
      width: 240px;
      background: #090a10;
      border-right: 1px solid var(--border);
      padding: 24px 14px;
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      z-index: 100;
      overflow-y: auto;
    }

    .logo {
      font-size: 25px;
      font-weight: 900;
      letter-spacing: 1px;
      padding: 0 12px 4px;
    }

    .logo-sub {
      color: var(--muted);
      font-size: 11px;
      padding: 0 12px 25px;
    }

    .nav-title {
      color: #555b6b;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.2px;
      padding: 0 12px 9px;
      text-transform: uppercase;
    }

    .nav button {
      width: 100%;
      background: transparent;
      border: 0;
      color: #9298a8;
      padding: 11px 12px;
      border-radius: 9px;
      text-align: left;
      margin-bottom: 3px;
      transition: 0.2s;
    }

    .nav button:hover,
    .nav button.active {
      background: #171925;
      color: #fff;
    }

    /* MAIN */
    .main {
      margin-left: 240px;
      width: calc(100% - 240px);
      padding: 30px;
    }

    .mobile-top {
      display: none;
    }

    .section {
      display: none;
    }

    .section.active {
      display: block;
    }

    .topline {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      align-items: flex-start;
      margin-bottom: 28px;
    }

    h1 {
      font-size: 30px;
      line-height: 1.15;
      margin-bottom: 7px;
    }

    h2 {
      font-size: 19px;
      line-height: 1.25;
      margin-bottom: 7px;
    }

    h3 {
      line-height: 1.35;
    }

    .subtitle,
    .muted {
      color: var(--muted);
      line-height: 1.5;
    }

    .status {
      border: 1px solid #244a38;
      background: #0b1a13;
      color: #62df99;
      padding: 8px 12px;
      border-radius: 999px;
      font-size: 12px;
      white-space: nowrap;
    }

    /* HERO */
    .hero {
      background:
        radial-gradient(
          circle at 85% 15%,
          rgba(139, 92, 246, 0.22),
          transparent 35%
        ),
        linear-gradient(
          135deg,
          #121421,
          #0c0e15
        );
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 28px;
      margin-bottom: 20px;
    }

    .hero h1 {
      max-width: 760px;
      font-size: 34px;
    }

    .hero p {
      max-width: 760px;
      color: var(--muted);
      line-height: 1.6;
      margin-top: 8px;
    }

    /* STATS */
    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 22px;
    }

    .stat,
    .card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 14px;
    }

    .stat {
      padding: 18px;
    }

    .stat-label {
      color: var(--muted);
      font-size: 12px;
      margin-bottom: 9px;
    }

    .stat-value {
      font-size: 25px;
      font-weight: 800;
    }

    /* GRID */
    .grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .card {
      padding: 20px;
    }

    .card.full {
      grid-column: 1 / -1;
    }

    /* FORMS */
    .field {
      margin-top: 15px;
    }

    label {
      display: block;
      font-size: 12px;
      color: #aeb3c0;
      margin-bottom: 7px;
    }

    input,
    textarea,
    select {
      width: 100%;
      background: var(--panel-3);
      border: 1px solid var(--border);
      color: #fff;
      border-radius: 9px;
      padding: 11px 12px;
      outline: none;
    }

    input::placeholder,
    textarea::placeholder {
      color: #606676;
    }

    input:focus,
    textarea:focus,
    select:focus {
      border-color: var(--accent);
    }

    textarea {
      min-height: 105px;
      resize: vertical;
    }

    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    /* BUTTONS */
    .btn {
      margin-top: 15px;
      border: 0;
      border-radius: 9px;
      padding: 11px 16px;
      background: var(--accent);
      color: #fff;
      font-weight: 750;
      transition: 0.2s;
    }

    .btn:hover {
      background: #7c4ee8;
      transform: translateY(-1px);
    }

    .btn.secondary {
      background: #1b1e29;
      border: 1px solid var(--border);
    }

    .btn.secondary:hover {
      background: #222633;
    }

    .btn.danger {
      background: #35151d;
      color: #ff9bad;
    }

    .btn.green {
      background: #12452e;
      color: #75e5a5;
      border: 1px solid #216b47;
    }

    .btn.blue {
      background: #102b46;
      color: #75bfff;
      border: 1px solid #204b72;
    }

    .btn.small {
      padding: 8px 11px;
      margin-top: 0;
      font-size: 12px;
    }

    /* OUTPUT */
    .output {
      margin-top: 15px;
      background: var(--panel-3);
      border: 1px solid var(--border);
      border-radius: 9px;
      padding: 14px;
      line-height: 1.6;
      white-space: pre-wrap;
      color: #dfe2e9;
      min-height: 45px;
      overflow-wrap: anywhere;
    }

    /* SCORES */
    .score {
      font-size: 46px;
      font-weight: 900;
      margin: 8px 0;
    }

    .good {
      color: var(--green);
    }

    .warn {
      color: var(--yellow);
    }

    .bad {
      color: var(--red);
    }

    /* METRICS */
    .metric-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-top: 15px;
    }

    .metric {
      padding: 15px;
      background: var(--panel-3);
      border: 1px solid var(--border);
      border-radius: 10px;
    }

    .metric strong {
      display: block;
      font-size: 22px;
      margin-top: 5px;
    }

    /* CHART */
    .chart {
      height: 230px;
      display: flex;
      align-items: flex-end;
      gap: 10px;
      padding: 18px 8px 8px;
      background: var(--panel-3);
      border: 1px solid var(--border);
      border-radius: 10px;
      margin-top: 15px;
      overflow: hidden;
    }

    .bar-wrap {
      flex: 1;
      height: 100%;
      display: flex;
      align-items: flex-end;
      min-width: 25px;
    }

    .bar {
      width: 100%;
      background: linear-gradient(
        to top,
        #7041d4,
        #a78bfa
      );
      border-radius: 6px 6px 2px 2px;
      min-height: 4px;
      position: relative;
    }

    .bar span {
      position: absolute;
      bottom: calc(100% + 5px);
      left: 50%;
      transform: translateX(-50%);
      font-size: 10px;
      color: #bfc3cf;
    }

    /* HISTORY / LEADERBOARD */
    .history-item,
    .leader-item,
    .experiment-item {
      border: 1px solid var(--border);
      background: var(--panel-3);
      border-radius: 10px;
      padding: 14px;
      margin-top: 10px;
    }

    .history-head,
    .leader-head {
      display: flex;
      justify-content: space-between;
      gap: 12px;
    }

    .rank {
      font-size: 20px;
      font-weight: 900;
    }

    /* PROFILE */
    .profile-box {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .recommendation {
      padding: 13px;
      background: #11131c;
      border-left: 3px solid var(--accent);
      border-radius: 6px;
      margin-top: 10px;
      line-height: 1.5;
    }

    .empty {
      color: var(--muted);
      padding: 20px 0;
    }

    .tag {
      display: inline-block;
      padding: 5px 8px;
      background: #191523;
      color: #bca9f8;
      border-radius: 999px;
      font-size: 11px;
      margin: 4px 4px 0 0;
    }

    .mini-note {
      color: var(--muted);
      font-size: 11px;
      line-height: 1.5;
      margin-top: 8px;
    }

    .footer-note {
      color: #686e7d;
      font-size: 11px;
      margin-top: 20px;
    }

    /* =========================================================
       COMMUNITY HUB
       ========================================================= */

    .community-hero {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(
          circle at 88% 8%,
          rgba(53, 208, 127, 0.18),
          transparent 34%
        ),
        radial-gradient(
          circle at 10% 90%,
          rgba(139, 92, 246, 0.10),
          transparent 35%
        ),
        linear-gradient(
          135deg,
          #111820,
          #0b1015
        );
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 28px;
      margin-bottom: 18px;
    }

    .community-hero h1 {
      font-size: 34px;
      margin-bottom: 9px;
    }

    .community-hero .community-kicker {
      color: var(--green);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }

    .community-hero p {
      max-width: 820px;
      color: var(--muted);
      line-height: 1.7;
    }

    .community-hero strong {
      color: #fff;
    }

    .community-principles {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 17px;
    }

    .community-principle {
      padding: 7px 10px;
      background: rgba(255,255,255,.035);
      border: 1px solid var(--border);
      border-radius: 999px;
      color: #c6cbd5;
      font-size: 11px;
    }

    .community-onboarding {
      display: grid;
      grid-template-columns: 1.25fr .75fr;
      gap: 18px;
      align-items: stretch;
      margin-bottom: 18px;
      background:
        linear-gradient(
          135deg,
          #10151b,
          #0d1016
        );
    }

    .community-onboarding-copy {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .community-onboarding-copy h2 {
      font-size: 22px;
    }

    .community-demo-note {
      margin-top: 14px;
      color: #b9c0cc;
      font-size: 12px;
      line-height: 1.65;
    }

    .community-demo-note strong {
      color: #fff;
    }

    .signup-box {
      background: var(--panel-3);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 16px;
    }

    .welcome-bonus {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      background: #0d1b14;
      border: 1px solid #214b35;
      border-radius: 10px;
      padding: 11px 12px;
      margin-bottom: 3px;
    }

    .welcome-bonus-label {
      color: #b4c7ba;
      font-size: 11px;
    }

    .welcome-bonus-points {
      color: var(--green);
      font-size: 18px;
      font-weight: 900;
      white-space: nowrap;
    }

    .community-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin: 16px 0;
    }

    .point-card {
      position: relative;
      overflow: hidden;
      background: #0b0d13;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 17px;
    }

    .point-card.primary {
      background:
        radial-gradient(
          circle at 90% 10%,
          rgba(139,92,246,.18),
          transparent 45%
        ),
        #0b0d13;
    }

    .point-card .big {
      font-size: 29px;
      font-weight: 900;
      margin-top: 5px;
    }

    .point-card .tiny {
      color: #697080;
      font-size: 10px;
      margin-top: 4px;
    }

    .community-section-label {
      color: #626979;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.1px;
      text-transform: uppercase;
      margin-bottom: 9px;
    }

    .mission-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      border: 1px solid var(--border);
      background: var(--panel-3);
      border-radius: 12px;
      padding: 16px;
      margin-top: 10px;
      transition: .2s;
    }

    .mission-item:hover {
      border-color: #343846;
      background: #0c0f15;
    }

    .mission-item h3 {
      font-size: 14px;
      margin-bottom: 5px;
    }

    .mission-item p {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.55;
      max-width: 470px;
    }

    .mission-points {
      color: var(--green);
      font-weight: 800;
      white-space: nowrap;
      margin-bottom: 7px;
      text-align: right;
    }

    .mission-right {
      flex-shrink: 0;
      text-align: right;
    }

    .earn-badge {
      display: inline-block;
      padding: 5px 8px;
      border-radius: 999px;
      background: #10261a;
      border: 1px solid #204a31;
      color: #73e3a0;
      font-size: 10px;
      margin-bottom: 8px;
    }

    .spend-badge {
      display: inline-block;
      padding: 5px 8px;
      border-radius: 999px;
      background: #1c1425;
      border: 1px solid #392650;
      color: #c6a8f5;
      font-size: 10px;
      margin-bottom: 8px;
    }

    .community-directory-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 12px;
    }

    .creator-card {
      border: 1px solid var(--border);
      background: var(--panel-3);
      border-radius: 12px;
      padding: 17px;
      margin-top: 10px;
      transition: .2s;
    }

    .creator-card:hover {
      border-color: #363a48;
      transform: translateY(-1px);
    }

    .creator-card.featured {
      border-color: #334c40;
      background:
        radial-gradient(
          circle at 95% 5%,
          rgba(53,208,127,.08),
          transparent 30%
        ),
        var(--panel-3);
    }

    .creator-card .creator-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .creator-name-row {
      display: flex;
      align-items: center;
      gap: 9px;
      flex-wrap: wrap;
    }

    .creator-name-row strong {
      font-size: 15px;
    }

    .demo-label {
      padding: 4px 7px;
      border-radius: 999px;
      font-size: 9px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .6px;
      color: #76e8a4;
      background: #0f271b;
      border: 1px solid #234f35;
    }

    .creator-meta {
      color: var(--muted);
      font-size: 12px;
      margin-top: 5px;
    }

    .creator-description {
      color: #9ba2b1;
      font-size: 12px;
      line-height: 1.55;
      margin-top: 11px;
    }

    .creator-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      align-items: center;
      margin-top: 12px;
    }

    .creator-actions .btn {
      margin-top: 0;
    }

    .demo-support {
      margin-top: 13px;
      background: #11171a;
      border: 1px solid #25383a;
      border-radius: 10px;
      padding: 12px;
    }

    .demo-support-title {
      color: #d5dde0;
      font-size: 12px;
      font-weight: 750;
    }

    .demo-support-text {
      color: #8f9a9f;
      font-size: 11px;
      line-height: 1.55;
      margin-top: 5px;
    }

    .support-links {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-top: 9px;
    }

    .support-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 9px;
      border-radius: 8px;
      background: #161a20;
      border: 1px solid var(--border);
      color: #e7eaf0;
      font-size: 11px;
      transition: .2s;
    }

    .support-link:hover {
      border-color: #444957;
      background: #1b2028;
    }

    .pill-row {
      margin-top: 9px;
    }

    .community-note {
      font-size: 11px;
      color: #777e8e;
      line-height: 1.6;
      margin-top: 13px;
    }

    .community-flow {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 15px;
    }

    .flow-box {
      padding: 14px;
      background: #0b0d13;
      border: 1px solid var(--border);
      border-radius: 10px;
    }

    .flow-number {
      width: 26px;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #18152a;
      border: 1px solid #302752;
      color: #c1a9f8;
      border-radius: 50%;
      font-size: 11px;
      font-weight: 900;
      margin-bottom: 9px;
    }

    .flow-box strong {
      display: block;
      font-size: 12px;
      margin-bottom: 4px;
    }

    .flow-box p {
      color: var(--muted);
      font-size: 11px;
      line-height: 1.5;
    }

    .community-ledger-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .point-rule {
      margin-top: 14px;
      padding: 13px;
      border-radius: 9px;
      background: #101219;
      border: 1px solid var(--border);
      color: #9299a8;
      font-size: 11px;
      line-height: 1.6;
    }

    .point-rule strong {
      color: #dfe2e8;
    }

    /* FOOTER */
    .section-footer {
      margin-top: 20px;
      color: #5f6573;
      font-size: 10px;
      line-height: 1.6;
    }

    /* RESPONSIVE */
    @media (max-width: 1100px) {
      .community-onboarding {
        grid-template-columns: 1fr;
      }

      .community-flow {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 900px) {
      .sidebar {
        transform: translateX(-100%);
        transition: 0.25s;
      }

      .sidebar.open {
        transform: translateX(0);
      }

      .main {
        margin-left: 0;
        width: 100%;
        padding: 72px 16px 25px;
      }

      .mobile-top {
        display: flex;
        position: fixed;
        z-index: 110;
        top: 0;
        left: 0;
        right: 0;
        height: 58px;
        background: #090a10;
        border-bottom: 1px solid var(--border);
        align-items: center;
        justify-content: space-between;
        padding: 0 16px;
      }

      .mobile-menu {
        background: #171925;
        border: 1px solid var(--border);
        color: #fff;
        padding: 7px 10px;
        border-radius: 7px;
      }

      .stats {
        grid-template-columns: 1fr 1fr;
      }

      .grid,
      .profile-box {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 650px) {
      .community-stats {
        grid-template-columns: 1fr 1fr;
      }

      .community-directory-head {
        flex-direction: column;
      }

      .creator-card .creator-head {
        align-items: flex-start;
        flex-direction: column;
      }
    }

    @media (max-width: 560px) {
      .hero h1 {
        font-size: 27px;
      }

      .community-hero h1 {
        font-size: 28px;
      }

      .stats {
        grid-template-columns: 1fr;
      }

      .row,
      .metric-grid {
        grid-template-columns: 1fr;
      }

      .topline {
        flex-direction: column;
      }

      .status {
        white-space: normal;
      }

      .community-stats {
        grid-template-columns: 1fr 1fr;
      }

      .mission-item {
        align-items: flex-start;
        flex-direction: column;
      }

      .mission-right {
        text-align: left;
      }

      .mission-points {
        text-align: left;
      }

      .welcome-bonus {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
</head>

<body>

  <!-- MOBILE TOP BAR -->
  <div class="mobile-top">
    <strong>RIZORA</strong>

    <button
      class="mobile-menu"
      type="button"
      onclick="toggleMobileMenu()"
    >
      â˜°
    </button>
  </div>


  <div class="app">

    <!-- SIDEBAR -->
