# RIZORA — backend environment template
#
# Keep real credentials only in Render/Vercel environment settings.
# Never commit a real secret key or password.

# Core runtime
PORT=3000
HOST=0.0.0.0
RIZORA_PUBLIC_URL=https://rizora.com.ng
RIZORA_CURRENCY=NGN
RIZORA_PAYMENT_CALLBACK=https://rizora.com.ng/
# External Neon PostgreSQL connection string; set privately in Render.
DATABASE_URL=

# Supabase Auth and private Storage. Neon remains the RIZORA application database.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_MEDIA_BUCKET=rizora-private-media

# Cloudinary signed uploads for public creator media and generated audio.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare Turnstile (server-side Siteverify is required).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Audius read-only search key for higher provider rate limits
AUDIUS_API_KEY=

# Google Sign-In
GOOGLE_CLIENT_ID=

# RIZORA AI — Groq (chat, creator AI and voice transcription)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# ElevenLabs (voice, voice isolation, voiceover and music)
ELEVENLABS_API_KEY=

# Pollinations (NOIR and PLAY image generation)
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell

# AIAPI-Pro / NovAI (NOIR video generation)
NOVAI_API_KEY=
NOVAI_VIDEO_MODEL=cogvideox-flash

# Paystack — Live
PAYSTACK_MODE=live
PAYSTACK_SECRET_KEY=
PAYSTACK_PREMIUM_PLAN_CODE=
PAYSTACK_PREMIUM_PLUS_PLAN_CODE=
RIZORA_PREMIUM_INITIAL_AMOUNT=400000
RIZORA_PREMIUM_PLUS_INITIAL_AMOUNT=1400000

# External RIZORA Ads limits
RIZORA_EXTERNAL_AD_MIN_NAIRA=1000
RIZORA_EXTERNAL_AD_MAX_NAIRA=10000000

# RIZORA transactional email / Resend
RESEND_API_KEY=
RIZORA_EMAIL_FROM=RIZORA <noreply@rizora.com.ng>
RIZORA_EMAIL_REPLY_TO=rizora.hq@gmail.com

# Media; set this only after a persistent production volume is configured.
# Production uploads use Cloudinary or the private Supabase bucket above.
RIZORA_MEDIA_ROOT=

# Official identity / protected account configuration
RIZORA_OFFICIAL_EMAIL=
RIZORA_OFFICIAL_PASSWORD=
RIZORA_ROMI_PASSWORD=
RIZORA_SUPER_ADMIN_EMAIL=
RIZORA_SUPER_ADMIN_PASSWORD=
RIZORA_SUPER_ADMIN2_EMAIL=
RIZORA_SUPERADMIN2_PASSWORD=


