# RIZORA — backend environment template
#
# Keep real credentials only in Render/Vercel environment settings.
# Never commit a real secret key or password.

# Core runtime
PORT=3000
HOST=0.0.0.0
RIZORA_PUBLIC_URL=https://rizora.com.ng
RIZORA_CURRENCY=NGN
RIZORA_PAYMENT_CALLBACK=https://rizora.com.ng/

# Google Sign-In
GOOGLE_CLIENT_ID=

# RIZORA AI
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# Paystack — Live
PAYSTACK_MODE=live
PAYSTACK_SECRET_KEY=
PAYSTACK_PREMIUM_PLAN_CODE=
PAYSTACK_PREMIUM_PLUS_PLAN_CODE=
RIZORA_PREMIUM_INITIAL_AMOUNT=400000
RIZORA_PREMIUM_PLUS_INITIAL_AMOUNT=1300000

# External RIZORA Ads limits
RIZORA_EXTERNAL_AD_MIN_NAIRA=1000
RIZORA_EXTERNAL_AD_MAX_NAIRA=10000000

# RIZORA transactional email / Resend
RESEND_API_KEY=
RIZORA_EMAIL_FROM=RIZORA <noreply@rizora.com.ng>
RIZORA_EMAIL_REPLY_TO=

# Media
RIZORA_MEDIA_ROOT=

# Official identity / protected account configuration
RIZORA_OFFICIAL_EMAIL=
RIZORA_OFFICIAL_PASSWORD=
RIZORA_ROMI_PASSWORD=
RIZORA_SUPER_ADMIN_EMAIL=
RIZORA_SUPER_ADMIN_PASSWORD=
RIZORA_SUPER_ADMIN2_EMAIL=
RIZORA_SUPERADMIN2_PASSWORD=
RIZORA_SUPER_ADMIN2_PASSWORD=


# Remita payment gateway
REMITA_MERCHANT_ID=
REMITA_SERVICE_TYPE_ID=
REMITA_API_KEY=
REMITA_BASE_URL=https://demo.remita.net
