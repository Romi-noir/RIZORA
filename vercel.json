{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rizora-guse.onrender.com/api/:path*"
    },
    {
      "source": "/join",
      "destination": "/"
    },
    {
      "source": "/signup",
      "destination": "/"
    },
    {
      "source": "/login",
      "destination": "/"
    },
    {
      "source": "/verification",
      "destination": "/verification.html"
    },
    {
      "source": "/verification/",
      "destination": "/verification.html"
    },
    {
      "source": "/studio",
      "destination": "/"
    },
    {
      "source": "/studio/",
      "destination": "/"
    },
    {
      "source": "/studio/:feature",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self)"
        }
      ]
    }
  ]
}

